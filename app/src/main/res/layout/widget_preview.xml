<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191C1E"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Europa-Park"
                android:textColor="#E1E2E4"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="ge&#246;ffnet"
                android:textColor="#70D977"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:background="#354A53"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="BEISPIEL"
            android:textColor="#CFE6F1"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:maxLines="1"
        android:text="vor 5 min"
        android:textColor="#B8C0C6"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="24 min\nSchnitt"
            android:textColor="#E1E2E4"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="55 min\nH&#246;chste"
            android:textColor="#E1E2E4"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="3\nAttr."
            android:textColor="#E1E2E4"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Blue Fire &#183; 35 min"
        android:textColor="#B1C8FF"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Arthur &#183; 25 min"
        android:textColor="#B1C8FF"
        android:textSize="11sp" />
</LinearLayout>
